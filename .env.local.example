# VenturePath — Environment variables
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored.

# Supabase — public (safe to expose in client code)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY_HERE

# Optional: legacy anon key for SDKs that haven't moved to publishable yet
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Future: server-only keys (NEVER commit, NEVER expose to client)
# SUPABASE_SERVICE_ROLE_KEY=  # only when needed for admin tasks
